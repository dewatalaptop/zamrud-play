# Semua opsional (ada default). Jangan commit nilai rahasia.
PORT=4000
# Lokasi berkas SQLite. Default: backend/data.db. Di Cloud Functions diarahkan ke os.tmpdir().
DB_PATH=./data.db
# Offset zona waktu "hari lokal" untuk hadiah harian/misi (menit dari UTC). WIB = 420.
TZ_OFFSET_MIN=420
# Folder hasil build frontend yang disajikan backend (default ../frontend/dist).
# STATIC_DIR=
# Pelapor bug otomatis (hasil `node local-worker/job.js register-app` di ai-app-builder).
# BUG_APP_ID=
# BUG_APP_KEY=
# BUG_APP_VERSION=1.0.0
